{
  "name": "langoneditor",
  "version": "0.1.0",
  "description": "Desktop editor, visualizer, importer and exporter for OKF knowledge bundles",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Henrique Breim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langonrock/editor.git"
  },
  "homepage": "https://github.com/langonrock/editor",
  "bugs": "https://github.com/langonrock/editor/issues",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "sidecar": "bun scripts/build-sidecar.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-http": "^2.5.2",
    "@tauri-apps/plugin-shell": "^2.3.1",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "d3-dsv": "^3.0.1",
    "fflate": "^0.8.3",
    "langonrock": "link:langonrock",
    "lucide-react": "^1.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@stylistic/eslint-plugin": "^2.13.0",
    "@tauri-apps/cli": "^2.9.1",
    "@types/bun": "^1.1.16",
    "@types/d3-dsv": "^3.0.7",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.1.11"
  }
}
